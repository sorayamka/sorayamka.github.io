---
import "@fontsource-variable/onest";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import CartDrawer from "../components/CartDrawer.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getLocale } from "../lib/i18n";
import { siteImages } from "../data/site";
import { getLanguageRoutes, isPreviewSite } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  pageClass?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = siteImages.hero,
  noindex = false,
  pageClass = "",
  schema,
} = Astro.props;
const locale = getLocale(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname, Astro.site);
const languageRoutes = getLanguageRoutes(Astro.url.pathname);
const alternateRu = languageRoutes.ru ? new URL(languageRoutes.ru, Astro.site) : undefined;
const alternateEn = languageRoutes.en ? new URL(languageRoutes.en, Astro.site) : undefined;
const isHome = ["/", "/en/", "/demo/"].includes(Astro.url.pathname);
const socialImage = new URL(isHome ? "/images/site/share-preview-v2.png" : image, Astro.site);
const preventIndexing = noindex || isPreviewSite(Astro.site);
const normalizeSchema = (value: unknown): unknown => {
  if (typeof value === "string" && /^https:\/\/(?:www\.)?7legion\.com(?:\/|$)/.test(value)) {
    const source = new URL(value);
    return new URL(`${source.pathname}${source.search}${source.hash}`, Astro.site).href;
  }
  if (Array.isArray(value)) return value.map(normalizeSchema);
  if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, normalizeSchema(item)]));
  return value;
};
const serializedSchema = schema ? JSON.stringify(normalizeSchema(schema)).replace(/</g, "\\u003c") : undefined;
---

<!doctype html>
<html lang={locale} id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1116" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {preventIndexing ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    {alternateRu && alternateEn && <link rel="alternate" hreflang="ru" href={alternateRu} />}
    {alternateRu && alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {alternateRu && alternateEn && <link rel="alternate" hreflang="x-default" href={alternateRu} />}
    <link rel="icon" type="image/png" href="/images/site/favicon.png" />
    <link rel="apple-touch-icon" href="/images/site/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "ru_RU"} />
    <meta property="og:site_name" content={locale === "en" ? "Seventh Legion" : "Седьмой Легион"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {isHome && <meta property="og:image:width" content="1200" />}
    {isHome && <meta property="og:image:height" content="630" />}
    {isHome && <meta property="og:image:type" content="image/png" />}
    <meta property="og:image:alt" content={locale === "en" ? "Seventh Legion — wholesale frozen meat supply" : "Седьмой Легион — оптовые поставки замороженной мясной продукции"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:label1" content={locale === "en" ? "English" : "Русский"} />
    <title>{title}</title>
    {serializedSchema && <script type="application/ld+json" set:html={serializedSchema} />}
  </head>
  <body class={pageClass} data-locale={locale}>
    <a class="skip-link" href="#main">{locale === "en" ? "Skip to content" : "Перейти к содержимому"}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
