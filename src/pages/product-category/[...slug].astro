---
import type { GetStaticPaths } from "astro";
import { products } from "../../data/site";

export const getStaticPaths = (() => {
  const routes = new Map<string, string>();
  for (const product of products) {
    const parts = product.path.replace(/^\/shop\//, "").split("/").filter(Boolean);
    if (parts[0]) routes.set(parts[0], `/shop/${parts[0]}/`);
    if (parts.length >= 3) routes.set(`${parts[0]}/${parts[1]}`, `/shop/${parts[0]}/${parts[1]}/`);
  }
  return [...routes].map(([source, target]) => ({
    params: { slug: source },
    props: { target },
  }));
}) satisfies GetStaticPaths;

interface Props {
  target: string;
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
