---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCta from "../components/ContactCta.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Стать партнёром — Седьмой Легион" description="Условия партнёрства для компаний, которым нужны стабильные оптовые поставки замороженной мясной продукции.">
  <PageHero
    eyebrow="Открыты к сотрудничеству"
    title="Стать"
    titleAccent="партнёром"
    lead="Формируем предложения под реальные задачи клиента: ассортимент, объём, логистику и коммерческие условия."
    statValue="01"
    statLabel="первый шаг"
    statNote="расскажите о задаче — предложим условия"
    breadcrumb="Партнёрам"
  />

  <section class="section">
    <div class="shell">
      <header class="section-head" data-reveal><div><span class="eyebrow">Что предлагаем</span><h2>Партнёрство как работающая система поставок.</h2></div><p>«Седьмой Легион» подходит компаниям, которым важны стабильный ассортимент, качество хранения и предсказуемая логистика.</p></header>
      <div class="partner-steps">
        <article class="partner-step" data-reveal><span>01</span><h3>Консультация</h3><p>Разбираем бизнес-задачу, ассортимент, объём и географию.</p></article>
        <article class="partner-step" data-reveal><span>02</span><h3>Предложение</h3><p>Формируем список позиций, цену и условия поставки.</p></article>
        <article class="partner-step" data-reveal><span>03</span><h3>Отгрузка</h3><p>Комплектуем партию, документы и рефрижераторную доставку.</p></article>
        <article class="partner-step" data-reveal><span>04</span><h3>Развитие</h3><p>Расширяем ассортимент и адаптируем регулярный график.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--dark"><div class="shell content-grid"><div class="prose" data-reveal><span class="eyebrow">Наши партнёры могут рассчитывать</span><h2 class="section--dark">Поддержку, ассортимент и условия.</h2><p>Консультационную поддержку на этапе развития бизнеса.</p><p>Регулярные поставки широкого ассортимента мясной продукции.</p><p>Эксклюзивные договоры и специальные коммерческие условия.</p><p>Актуальную информацию о продажах и наличии продукции.</p></div><div class="fact-panel" data-reveal><span>Следующий шаг</span><strong>B2B</strong><p>Свяжитесь с отделом продаж и расскажите о своей задаче.</p><a class="button button--red" style="margin-top:28px" href="mailto:info@myaso.msk.ru">Отправить запрос <Icon name="arrow" size={18} /></a></div></div></section>
  <ContactCta title="Обсудим формат сотрудничества?" text="Подготовим коммерческое предложение под ваш ассортимент и объём поставки." primaryLabel="Связаться с отделом продаж" />
</BaseLayout>
