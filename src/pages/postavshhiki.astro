---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCta from "../components/ContactCta.astro";

const groups = [
  { title: "Замороженная птица", items: ["ПФ «РАССВЕТ»", "ТМ «СДТ-ТУР»", "ТМ «Черкизово»", "ТМ «Агрокомплекс»", "ТМ «Акашево»", "ОАО «Приосколье»", "ТМ «ЭкоПтица»", "ТМ «Куриное Царство»", "ТМ «Павловская курочка»", "ТМ «Петруха»", "ТМ «Ясные Зори»", "ТМ «Ярославский бройлер»"] },
  { title: "Говядина", items: ["ООО «ТК Мираторг»", "АО «Агрокомплекс»", "ООО «Союз М»", "ООО «МПЗ-Лунево»", "ООО «МК Казанский»", "АО «Русский мрамор»", "ТМ «Семидаль»", "ТМ «Тимашевскмясопродукт»"] },
  { title: "Свинина", items: ["ООО ТД «Черкизово»", "ООО «ТК Мираторг»", "ООО «Мясной Дом Бородина»", "ООО «МПК Полянское»", "ООО «МПК Атяшевский»", "ООО «Воронежский Бекон»", "ТМ «Семидаль»", "ТМ «Союз-М»", "МК «Всеволожский»", "ООО МПК «Богдановский»"] },
  { title: "Индейка", items: ["ООО ТД «Черкизово»", "ТМ «Пава-пава»", "ТМ «Turkey Pul»", "ТМ «Дамди ЕТ»", "ТМ «Краснобор»", "ТМ «Линдипрайм»", "ТМ «Лобановская индейка»", "ООО «Агро-плюс»", "ТМ «Индилайт»"] },
  { title: "Утка", items: ["ОАО «Племрепродуктор»", "ТМ «Уткино»", "ТМ «Утиная Ферма»", "ТМ «Фермерская»", "ТМ «Наша Утяша»", "ТМ «Митвиль»"] },
  { title: "Другие поставщики", items: ["ООО «Гвардия»", "ГК «Агропром Комплектация»", "МК «Йошкар-олинский»", "ООО «Тамбовский бекон»", "ООО «МПК Онежские деликатесы»", "ТМ «Ремит»", "ООО «Кролберри»"] },
];
---

<BaseLayout title="Поставщики — Седьмой Легион" description="Проверенные поставщики мяса птицы, свинины, говядины, индейки, утки, крольчатины и полуфабрикатов.">
  <PageHero
    eyebrow="Только проверенные партнёры"
    title="Поставщики"
    lead="Работаем с производителями, которые обеспечивают стабильные отгрузки и соответствуют требованиям качества."
    statValue="100+"
    statLabel="поставщиков в сети"
    statNote="проверенные производители"
    breadcrumb="Поставщики"
  />
  <section class="section"><div class="shell"><header class="section-head" data-reveal><div><span class="eyebrow">Производственная матрица</span><h2>Поставщики по категориям</h2></div><p>Состав партнёров регулярно расширяется. Актуальный список и наличие позиций уточняйте у менеджера.</p></header><div class="supplier-groups">{groups.map((group) => <section class="supplier-group" data-reveal><h2>{group.title}</h2><ul>{group.items.map((item) => <li>{item}</li>)}</ul></section>)}</div></div></section>
  <ContactCta title="Хотите стать поставщиком?" text="Пришлите коммерческое предложение и информацию о продукции — команда закупок свяжется с вами." primaryLabel="Связаться по поставкам" />
</BaseLayout>
