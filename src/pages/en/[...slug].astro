---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ContactCta from "../../components/ContactCta.astro";
import { englishPages } from "../../lib/i18n";
import { brands, certificates } from "../../data/site";
import BrandGrid from "../../components/BrandGrid.astro";

export const getStaticPaths = (() =>
  Object.entries(englishPages).map(([slug, copy]) => ({
    params: { slug },
    props: { copy },
  }))) satisfies GetStaticPaths;

const { copy } = Astro.props;
const showCertificates = Astro.url.pathname === "/en/sertifikaty/";
---

<BaseLayout title={`${copy.title} — Seventh Legion`} description={copy.lead}>
  <PageHero
    eyebrow={copy.eyebrow}
    title={copy.title}
    lead={copy.lead}
    statValue="23+"
    statLabel={copy.statLabel}
    statNote={copy.statNote}
    breadcrumb={copy.title}
  />
  <section class="section">
    <div class="shell content-grid">
      <div>
        <span class="eyebrow">Seventh Legion</span>
        <h2>{copy.title}</h2>
      </div>
      <div class="content-grid__copy">
        {copy.body.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button button--dark" href="/en/contact-us/">Contact our sales team</a>
      </div>
    </div>
  </section>
  {Astro.url.pathname === "/en/brands/" && <section class="section"><div class="shell"><BrandGrid brands={brands} /></div></section>}
  {showCertificates && <section class="section"><div class="shell">
    <h2>Archived supplier documents</h2>
    <p>Original documents are available in Russian. Confirm validity for your shipment with our team.</p>
    <div class="certificate-grid">
      {certificates.map((certificate) => <div class="certificate-card">
        <a href={certificate.files?.[0]?.path ?? certificate.image} target="_blank" rel="noopener">
          <img src={certificate.image} alt={certificate.name} width="800" height="600" loading="lazy" />
          <h3>{certificate.name}</h3>
        </a>
        <a href={`/certificates/${certificate.slug}/`}>All documents · {certificate.files?.length ?? 0} PDF</a>
      </div>)}
    </div>
  </div></section>}
  <ContactCta
    title="Need a commercial offer?"
    text="Send us the product list, volume and delivery destination. Our team will prepare the next steps."
    primaryLabel="Contact our sales team"
  />
</BaseLayout>
