---
import type { Brand } from "../data/types";
import { getLocale } from "../lib/i18n";

interface Props {
  brands: Brand[];
  limit?: number;
  compact?: boolean;
}

const { brands, limit, compact = false } = Astro.props;
const visibleBrands = limit ? brands.slice(0, limit) : brands;
const locale = getLocale(Astro.url.pathname);
const brandLink = (brand: Brand) => `${locale === "en" ? "/en" : ""}/brands/${brand.slug}/`;
---

<div class:list={["brand-grid", { "brand-grid--compact": compact }]} data-brand-grid>
  {visibleBrands.map((brand, index) => (
    <a class="brand-card" href={brandLink(brand)} id={`${brand.slug}-${index}`} data-brand={brand.slug} data-reveal style={`--delay:${Math.min(index, 12) * 35}ms`}>
      {brand.logo ? (
        <img src={brand.logo} alt={brand.name} width="320" height="220" loading="lazy" decoding="async" />
      ) : (
        <span class="brand-card__monogram">{brand.name.slice(0, 2).toUpperCase()}</span>
      )}
      <p translate="no">{brand.name}</p>
      <span class="brand-card__action">{locale === "en" ? "Products and documents →" : "Товары и документы →"}</span>
    </a>
  ))}
</div>
