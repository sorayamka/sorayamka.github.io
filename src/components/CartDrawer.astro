---
import Icon from "./Icon.astro";
import { getLocale, localizedPath } from "../lib/i18n";

const locale = getLocale(Astro.url.pathname);
const link = (path: string) => localizedPath(path, locale);
---

<dialog class="cart-drawer" id="cart-drawer" aria-labelledby="cart-drawer-title">
  <div class="cart-drawer__panel">
    <header class="cart-drawer__header">
      <div>
        <span>{locale === "en" ? "Working cart" : "Рабочая корзина"}</span>
        <h2 id="cart-drawer-title">{locale === "en" ? "Order list" : "Состав заказа"}</h2>
      </div>
      <button class="icon-button" type="button" data-cart-close aria-label={locale === "en" ? "Close cart" : "Закрыть корзину"}><Icon name="close" size={22} /></button>
    </header>
    <div class="cart-drawer__body" data-cart-drawer-items></div>
    <div class="cart-drawer__empty" data-cart-empty>
      <span class="cart-drawer__empty-mark">0</span>
      <h3>{locale === "en" ? "Your list is empty" : "Пока пусто"}</h3>
      <p>{locale === "en" ? "Add products from the catalog to build a working order list." : "Добавляйте позиции из каталога — здесь сохранится рабочий список."}</p>
      <a class="button button--light" href={link("/shop/")}>{locale === "en" ? "Go to catalog" : "Перейти в каталог"} <Icon name="arrow" size={18} /></a>
    </div>
    <footer class="cart-drawer__footer" data-cart-footer hidden>
      <p>{locale === "en" ? "The list is stored in your browser and is not sent to the sales team." : "Список сохраняется в браузере и не отправляется менеджеру."}</p>
      <div class="cart-drawer__actions">
        <a class="button button--outline-light" href={link("/cart/")}>{locale === "en" ? "Open cart" : "Открыть корзину"}</a>
        <button class="button button--red" type="button" data-cart-download><Icon name="download" size={18} />{locale === "en" ? "Download" : "Скачать"}</button>
      </div>
    </footer>
  </div>
  <div class="cart-drawer__backdrop" aria-hidden="true"></div>
</dialog>
